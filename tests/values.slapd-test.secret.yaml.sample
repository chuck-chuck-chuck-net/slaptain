# In operator mode (deploy via slapd-cluster chart) the operator auto-generates
# admin-password and root-password and stores them in the operator-managed secrets:
#   slapd-passwords        (admin-password, replication-password)
#   slapd-config-password  (root-password)
# tests/values.slapd-test.yaml already points to these via passwordsSecretName /
# configPasswordSecretName, so no slapd.adminPassword / slapd.rootPassword is needed here.
#
# Only the readpw credentials need to be provided:
bootstrap:
    # These need to be provided as hashes; we store them in the ldap entries
    readpwUsers:
        appsuite: ...  # generate with: slappasswd -h {SSHA} -s yourpassword
        dovecot: ...
        keycloak: ...
    # These need to be provided as plain; we need these to bind as readpw users in e2e tests
    readpwPasswords:
        appsuite: ...
        dovecot: ...
        keycloak: ...
