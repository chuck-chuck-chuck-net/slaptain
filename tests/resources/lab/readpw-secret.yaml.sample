# Plaintext passwords for read-only service accounts.
# Used by e2e tests to bind as readpw users and verify ACL enforcement.
#
# The actual readpw-secret.yaml is SOPS-encrypted.
# To create it from this sample:
#   1. Fill in the plaintext passwords below.
#   2. Ensure the SSHA hashes in database.yaml match these passwords.
#      Generate with: slappasswd -h {SSHA} -s <password>
#   3. Encrypt: sops -e readpw-secret.yaml.sample > readpw-secret.yaml
apiVersion: v1
kind: Secret
metadata:
  name: slapd-test-passwords
type: Opaque
stringData:
  readpw-appsuite: "REPLACE_WITH_PLAINTEXT"
  readpw-dovecot: "REPLACE_WITH_PLAINTEXT"
  readpw-keycloak: "REPLACE_WITH_PLAINTEXT"
