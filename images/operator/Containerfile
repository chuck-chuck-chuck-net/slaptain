# Build context is the operator module (operator/), not the repository root, so
# an edit elsewhere in the repository leaves the cached layers valid.
FROM golang:1.26@sha256:5ebd6e7dc13f9e273ed9470679eb295d8b6e7de3b6379c8a5e17a9e6c3eabd38 AS builder
WORKDIR /workspace
COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download
COPY . .
# Build the whole ./cmd package (main.go + backup_subcommand.go), not a single
# file — `go build ./cmd/main.go` would miss the sibling subcommand file.
# The slapd exporter is not in this image: it is its own module, image and
# version line (images/slapd-exporter, ADR-033 decision 4).
# The cache mounts keep the module and build caches across builds, so a source
# edit recompiles the packages it touched instead of all of client-go.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -trimpath -o /manager ./cmd

FROM gcr.io/distroless/static-debian13:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=builder /manager /manager
USER 65532:65532
ENTRYPOINT ["/manager"]
