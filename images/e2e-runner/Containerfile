# e2e test runner image — compiles the test binary and runs it in distroless.
# The binary is a fully static Go binary; no shell, no kubectl, no libc needed.
# kubectl port-forward is skipped automatically when LDAP_ADDR is set (in-cluster mode).
#
# Build context must be the repo root:
#   podman build -f images/e2e-runner/Containerfile -t ... .

FROM golang:1.25 AS builder

WORKDIR /workspace/tests/e2e

# Copy the operator module (e2e depends on it via replace ../../operator).
COPY operator/go.mod operator/go.sum /workspace/operator/
RUN cd /workspace/operator && go mod download
COPY operator/api/ /workspace/operator/api/

# Dependency layer (cached separately from source changes).
COPY tests/e2e/go.mod tests/e2e/go.sum ./
RUN go mod download

# Compile the test binary.  -c compiles without running; the result accepts
# standard `go test` flags plus Ginkgo flags (--ginkgo.v, --ginkgo.timeout, …).
COPY tests/e2e/ .
RUN CGO_ENABLED=0 GOOS=linux go test -c -o /e2e-runner

# ── Runtime ───────────────────────────────────────────────────────────────────
FROM gcr.io/distroless/static-debian13:nonroot

COPY --from=builder /e2e-runner /e2e-runner

USER 65532:65532

# Default: verbose output.  Override CMD in the Job spec if needed.
ENTRYPOINT ["/e2e-runner"]
CMD ["--ginkgo.v", "-test.v"]
