# OpenLDAP 2.6 (Debian trixie package) slapd runtime image — the LEGACY variant.
#
# Built as <registry>/slaptain/slapd:<tag>-ol26. The default `slapd:<tag>` image
# is OpenLDAP 2.7.1 from the vendored packaging fork (images/openldap/).
# Keep this variant for legacy interop and hot-migration clusters that must run
# the same 2.6 code as their migration source — see ADR-021 and ADR-011.
#
# Not for new clusters: it is the legacy storage format (LMDB 0.9), and a
# cluster born here pays a dump-and-reload to reach the default line later.
#
# This comment used to say the variant is "knowingly affected by ITS#9580 (the
# sync cookie is stale refresh storm after a pod loses its data volumes)".
# Retracted: that storm is ITS#9398, it is present in 2.7 just as much, and
# since 0.5.0 both lines get the accesslog syncprov checkpoint that addresses
# it. There is no storm advantage to the default pair.

# ── Build / gather stage ────────────────────────────────────────────────────
# The Debian package version is PINNED, not floated (ADR-040 decision 1).
#
# An unpinned `apt-get install slapd` takes whatever the archive serves on the
# day, which makes this image unreproducible and — once the tag carries the
# OpenLDAP version — renames the artifact without any change in this tree. A
# pin turns a Debian point release into a reviewable commit instead of a silent
# difference between two builds of the same source.
#
# It will eventually fail to resolve, because a stable point release replaces
# packages in the mirror and the old version leaves it. That failure is the
# feature: bump OPENLDAP_OL26_VERSION, rebuild, and re-run the 2.6 e2e cycle —
# which is exactly the review a new upstream slapd deserves and would otherwise
# never get.
ARG OPENLDAP_OL26_VERSION=2.6.10+dfsg-1

FROM debian:trixie-slim AS build
ARG OPENLDAP_OL26_VERSION

RUN apt-get update && apt-get install -y --no-install-recommends \
        slapd="${OPENLDAP_OL26_VERSION}" \
        ldap-utils="${OPENLDAP_OL26_VERSION}" \
        dpkg-dev \
    && rm -rf /var/lib/apt/lists/*

# The probe client and the server must be the same build (ADR-030): slapd and
# ldap-utils come from one source package, so a version skew here means apt
# resolved something we did not ask for.
#
# It cannot fail while BOTH packages are pinned to the same variable — apt
# installs exactly those or fails outright. It is here for the edit that pins
# one and lets the other float, which is the plausible way these two drift.
RUN set -eux; \
    s="$(dpkg-query -W -f='${Version}' slapd)"; \
    u="$(dpkg-query -W -f='${Version}' ldap-utils)"; \
    [ "$s" = "$u" ] || { echo "slapd $s != ldap-utils $u" >&2; exit 1; }; \
    echo "OpenLDAP (Debian) $s"

# Assemble a staging root for the distroless runtime.
# NOTE: do NOT pre-create /staging/usr/lib/ldap here — cp -r creates it
# correctly only when the destination does not yet exist.  If the dir exists
# beforehand, cp -r would nest the source inside it (ldap/ldap/back_mdb.so).
RUN install -d \
      /staging/usr/sbin \
      /staging/usr/bin \
      /staging/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH) \
      /staging/etc/ldap \
      /staging/ldap-config \
      /staging/ldap-data \
      /staging/tmp

# Binary
RUN cp /usr/sbin/slapd /staging/usr/sbin/

# ldapwhoami — the readiness probe (ADR-030).
#
# The one LDAP client this image carries, and it is here because kubelet offers
# HTTPGet, TCPSocket or Exec and slapd speaks no HTTP. TCPSocket is proven
# insufficient: the pod that froze for 874 s accepted connections throughout and
# answered nothing, holding readyReplicas the whole time.
#
# ldapwhoami rather than ldapsearch: WhoAmI is an extended operation that reads
# no entry, so the probe cannot be broken by a user's ACLs — "does slapd answer
# at all" stays independent of "may this identity read anything". It comes from
# the same package build as slapd itself, so client and server can never drift.
#
# This is NOT a general-purpose toolkit: debugging belongs in slapd-toolkit
# (slctl debug attaches it as an ephemeral container). One binary, one purpose.
RUN cp /usr/bin/ldapwhoami /staging/usr/bin/

# Schema files (referenced by bootstrap-generated config)
RUN cp -r /etc/ldap/schema /staging/etc/ldap/schema

# Dynamic backend/overlay modules
# (later: compile these in statically and drop this directory entirely)
RUN cp -r /usr/lib/ldap /staging/usr/lib/ldap

# Shared libs required by slapd and its loadable modules.
# Using ldd instead of globs: trixie ships libldap.so.2 / liblber.so.2
# (not libldap-2.5.so.* as on bookworm), so name-based globs are fragile.
RUN set -e; arch=$(dpkg-architecture -qDEB_HOST_MULTIARCH); \
    # Collect all .so paths from slapd and every loadable module, then copy
    # both the real file and any SONAME symlink for each dependency.
    { ldd /usr/sbin/slapd; ldd /usr/bin/ldapwhoami; \
      for mod in /usr/lib/ldap/*.so; do ldd "$mod" 2>/dev/null; done; \
    } | awk '/=>/ { print $3 }' | sort -u | \
    while read lib; do \
        real=$(readlink -f "$lib") || continue; \
        cp "$real" /staging/usr/lib/$arch/ 2>/dev/null || true; \
        [ "$lib" != "$real" ] && cp -P "$lib" /staging/usr/lib/$arch/ 2>/dev/null || true; \
    done; \
    # SASL plugin directory (loaded at runtime, not via ldd)
    cp -r /usr/lib/$arch/sasl2 /staging/usr/lib/$arch/ 2>/dev/null || true; \
    # libgcc_s.so.1 is dlopen'd lazily by glibc for pthread_exit stack
    # unwinding — it never appears in ldd output, so copy it explicitly.
    cp -a /usr/lib/$arch/libgcc_s.so.1 /staging/usr/lib/$arch/

# Minimal /etc/passwd and /etc/group — distroless/base only ships root+nobody
RUN printf \
      'root:x:0:0:root:/root:/sbin/nologin\nopenldap:x:1024:1024:OpenLDAP:/nonexistent:/sbin/nologin\n' \
      > /staging/etc/passwd && \
    printf 'root:x:0:\nopenldap:x:1024:\n' > /staging/etc/group

# ── Runtime stage ───────────────────────────────────────────────────────────
FROM gcr.io/distroless/base-debian13

COPY --from=build /staging/ /

# /ldap-config and /ldap-data are populated by the init container
VOLUME ["/ldap-config", "/ldap-data"]

USER 1024:1024

EXPOSE 1024 1025

# Chart overrides args; -F points to config written by the init container
ENTRYPOINT ["/usr/sbin/slapd"]
