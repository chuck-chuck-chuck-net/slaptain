# OpenLDAP 2.7.1 Debian packages, built from pristine upstream sources with the
# vendored packaging fork in ./debian (see README.md and ADR-021).
#
# This image is a *build artifact carrier*, not a runtime image: the final stage
# is `scratch` holding nothing but /debs. Both images/slapd/Containerfile and
# images/slapd-init/Containerfile consume it via
#   COPY --from=${OPENLDAP_DEB_IMAGE} /debs /debs
# so the package build runs ONCE per tag and feeds both. It is never pushed to a
# registry — `make build-openldap-deb` tags it under localhost/.
#
# BUILD_VARIANT selects what comes out (see docs/DEBUG-IMAGES.md):
#
#   release  what ships. Only the four runtime packages are collected.
#   debug    the SAME build — identical flags, identical binaries — but the
#            -dbgsym packages are collected too. A crash reproduces exactly as
#            it does in production, and the backtrace resolves.
#   asan     AddressSanitizer: every allocation intercepted, an invalid free or
#            use-after-free reported AT THE MOMENT IT HAPPENS with the
#            allocation, free and access stacks. Unoptimised, ~2x slower, and
#            therefore a different program than the one that crashed — read it
#            for the cause, not for the reproduction.
#
# Debug info travels as -dbgsym packages rather than DEB_BUILD_OPTIONS=nostrip,
# which looks like the simpler route and is a trap: dh drops dh_strip from the
# sequence under nostrip, and this packaging creates the slapadd/slappasswd/…
# hardlinks inside override_dh_strip. The package then builds, installs, and has
# no slapadd — which surfaces as a postinst failure three images downstream.

# ── Package build stage ─────────────────────────────────────────────────────
FROM debian:trixie-slim AS deb-build

ARG OPENLDAP_VERSION=2.7.2
# sha256 of the upstream release tarball. A mismatch fails the build — this is
# the only integrity check on the download, so it must never be relaxed.
ARG OPENLDAP_SHA256=aad731aa22118ff327b9b4ddfc4b6f18ef9476586205da88a532e90940b523d2
ARG OPENLDAP_URL=https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-${OPENLDAP_VERSION}.tgz
# Upstream test suite: skipped by default (it takes tens of minutes and needs a
# working loopback/krb5 setup). Set to 1 to run it — see README.md.
ARG RUN_UPSTREAM_TESTS=0
# release | debug | asan — see the header. Anything else fails the build.
ARG BUILD_VARIANT=release

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        devscripts \
        equivs \
        fakeroot \
        quilt \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Fetch and verify the upstream tarball. The sha256 is pinned above; the build
# stops here on any mismatch rather than packaging an unverified source tree.
RUN set -eux; \
    curl -fsSL -o openldap-${OPENLDAP_VERSION}.tgz "${OPENLDAP_URL}"; \
    echo "${OPENLDAP_SHA256}  openldap-${OPENLDAP_VERSION}.tgz" | sha256sum -c -; \
    tar xzf openldap-${OPENLDAP_VERSION}.tgz; \
    # dpkg-source keeps the .orig tarball next to the source tree.
    cp openldap-${OPENLDAP_VERSION}.tgz openldap_${OPENLDAP_VERSION}.orig.tar.gz

# The vendored packaging fork.
COPY debian /build/openldap-${OPENLDAP_VERSION}/debian

# local-patches/ is the ONE copy of slaptain's own patches, shared with the 2.6
# source build, which copies them the same way. They used to be duplicated into
# debian/patches/ as well, and the two copies had nothing keeping them in step:
# regenerating one left the other applying to a tree it no longer matched, and
# the build would not have said so.
COPY local-patches /build/local-patches

WORKDIR /build/openldap-${OPENLDAP_VERSION}

# Whether this build carries slaptain's own behaviour patches (ADR-040
# decision 2). They are NOT in debian/patches/series: that series is the
# packaging fork, and ours are a separate axis, so a build either appends them
# or does not and the two are otherwise the same source.
#
# 1 is the default TODAY and not forever. ADR-040 inverts it — the unsuffixed
# build becomes the pure one and patched takes a token — but only after the
# pure pair has been through a multi-site cycle, because every image this
# project has ever built and every e2e it has ever run used the patched build.
# Until that cycle, defaulting to 0 would ship an untested default.
ARG SLAPTAIN_PATCHES=1

# Which of local-patches/ go in when SLAPTAIN_PATCHES=1. The default is the
# published 2.7 set: the phase patch alone, because 2.7 already emits the purge
# timing line natively and accesslog-purge-logging.patch exists only to
# backport it to a 2.6 tree that does not. Space-separated, each a basename in
# local-patches/. The 2.6 forward-port is a separate file with its own default
# of both; this one exists so the list is stated rather than buried in a shell
# line, and so the two builds disagree visibly.
ARG SLAPTAIN_PATCH_LIST="accesslog-purge-phase.patch"

# Appended last, after Debian's own series, exactly as the 2.6 source build
# does it. Pushing and popping the whole series here fails the build on a
# patch that does not apply, rather than halfway through dpkg-buildpackage.
#
# The package VERSION moves with the patch set, from this same argument. The
# revision token is `+slaptainN` when our patches are applied and `+pureN` when
# they are not — same N, same changelog entry, one token substituted. Without
# this a pure build reports `2.7.1-0+slaptain3`, byte-identical to the patched
# one, which breaks two things that depend on telling them apart:
#
#   * ADR-040 decision 3 names `slapd -VV` as the second, independent route to
#     an image's provenance. On the axis that matters today — patched versus
#     pure — there is no second route if both answers are the same string. It
#     is also the only route available from inside a running pod, where the OCI
#     labels are not readable.
#   * the operator's AccesslogPurgeConverged=False/PurgePhaseUnsupported tells
#     the reader to pin an image carrying the patch and to verify it with
#     `slapd -VV`. A pure build satisfies that test while carrying no patch, so
#     the operator verifies the version, concludes the image is right, and has
#     no next step.
#
# N is NOT derived and must not be: it is a hand-maintained packaging revision
# with a hand-written changelog entry saying what moved, and it covers
# packaging work as well as patches (+slaptain1 carried no behaviour patches at
# all). What is derived is which token it wears. `pure` and `slaptain` are the
# two values of ADR-040's `select.flavour`, deliberately: the version string
# names the axis with the same words the API does.
RUN set -eux; \
    if [ "${SLAPTAIN_PATCHES}" = "1" ]; then \
        for p in ${SLAPTAIN_PATCH_LIST}; do \
            test -f "/build/local-patches/$p" || { \
                echo "no such patch in local-patches/: $p" >&2; exit 1; }; \
            cp "/build/local-patches/$p" debian/patches/; \
            echo "$p" >> debian/patches/series; \
        done; \
        QUILT_PATCHES=debian/patches quilt --quiltrc /dev/null push -a; \
        QUILT_PATCHES=debian/patches quilt --quiltrc /dev/null pop -a; \
        echo "slaptain patches: applied"; \
    else \
        echo "slaptain patches: NONE (pure upstream sources)"; \
        cur=$(dpkg-parsechangelog -S Version); \
        pure=$(printf '%s' "$cur" | sed 's/+slaptain\([0-9][0-9]*\)$/+pure\1/'); \
        # Refuse rather than ship the colliding string: if the changelog ever
        # stops ending in +slaptainN the substitution silently does nothing,
        # and a no-op here is exactly the defect this block exists to prevent.
        if [ "$pure" = "$cur" ]; then \
            echo "version gate: '$cur' does not end in +slaptainN, cannot derive \
the pure revision — fix debian/changelog or this rule" >&2; exit 1; \
        fi; \
        sed -i "1s|(${cur})|(${pure})|" debian/changelog; \
        got=$(dpkg-parsechangelog -S Version); \
        [ "$got" = "$pure" ] || { \
            echo "version gate: rewrote the changelog but it still reports '$got'" >&2; \
            exit 1; }; \
        echo "package version: $cur -> $got"; \
    fi

# apt-get update again: the stage above dropped the package lists, and
# mk-build-deps needs them to resolve the build dependencies.
RUN apt-get update \
    && mk-build-deps -i -r -t 'apt-get -y --no-install-recommends' debian/control \
    && rm -rf /var/lib/apt/lists/*

# DFSG_NONFREE=1: we build the pristine upstream tarball, so debian/rules must
# skip both its DFSG-freeness assertion and its schema substitution (which
# expects the +dfsg-repacked source layout).
#
# Note there is deliberately NO DPKG_GENSYMBOLS_CHECK_LEVEL override here: the
# 2.6 -> 2.7 libldap ABI delta is recorded in debian/libldap2.symbols, so an
# unexpected symbol change fails the build instead of being papered over.
RUN set -eux; \
    export DFSG_NONFREE=1; \
    if [ "${RUN_UPSTREAM_TESTS}" = "1" ]; then check=""; else check="nocheck"; fi; \
    opts="${check} parallel=$(nproc)"; \
    case "${BUILD_VARIANT}" in \
      release|debug) ;; \
      asan) \
        # An optimised frame lies about who called whom, and under ASan we are
        # reading the backtrace rather than reproducing a timing-sensitive race.
        opts="${opts} noopt"; \
        # debian/rules sets DEB_BUILD_MAINT_OPTIONS unconditionally (line 4), so
        # a sanitize=+address passed through the environment there is silently
        # discarded. The *_APPEND variables are the user-side counterparts:
        # dpkg-buildflags reads them from the environment and debian/rules never
        # touches them.
        export DEB_CFLAGS_APPEND="-fsanitize=address -fno-omit-frame-pointer"; \
        export DEB_CXXFLAGS_APPEND="-fsanitize=address -fno-omit-frame-pointer"; \
        export DEB_LDFLAGS_APPEND="-fsanitize=address"; \
        # _FORTIFY_SOURCE and ASan interpose the same functions; the hardening
        # flags put -D_FORTIFY_SOURCE in CPPFLAGS, so undefine it last.
        export DEB_CPPFLAGS_APPEND="-U_FORTIFY_SOURCE"; \
        # The .symbols gate above guards a release ABI. A sanitized build is not
        # a release and can legitimately differ; failing it would say nothing.
        export DPKG_GENSYMBOLS_CHECK_LEVEL=0; \
        ;; \
      *) echo "BUILD_VARIANT must be release, debug or asan (got '${BUILD_VARIANT}')" >&2; exit 1 ;; \
    esac; \
    export DEB_BUILD_OPTIONS="${opts}"; \
    dpkg-buildpackage -us -uc -b

# ── version/flavour agreement gate ──────────────────────────────────────────
# The build has just decided two things from one argument: which patches went
# in, and which revision token the package wears. This asserts they agree, on
# the artifacts that were actually produced.
#
# It exists because the two can come apart silently and in the direction that
# hurts: a future change that drops a patch but leaves the version alone ships
# a pure slapd announcing itself as patched, and every downstream check — the
# OCI label's corroborating route, the operator's condition message, a human
# reading `slapd -VV` — then agrees on the wrong answer. A build that cannot
# say which of the two it is should not produce an image.
#
# SYMMETRIC, like the logpurge gate below: each flavour asserts its own token
# and the absence of the other's, so one of the two always runs and neither
# passes by not executing. (The symmetry lives in the metadata route; the
# binary route asserts equality with it, for the reason noted at that step.)
#
# TWO ROUTES, because they fail differently: the .deb's control metadata (what
# apt and the OCI label derivation see) and the binary's compiled-in string
# (what `slapd -VV` prints inside a running pod, which is the one the operator
# condition tells people to check). The metadata route runs for every variant;
# the binary route is skipped under asan, where a non-zero exit says nothing
# about the string — same reasoning as the gate below.
RUN set -eux; \
    case "${SLAPTAIN_PATCHES}" in \
      1) want=slaptain; other=pure ;; \
      *) want=pure;     other=slaptain ;; \
    esac; \
    deb_ver=$(dpkg-deb -f /build/slapd_*.deb Version); \
    echo "version gate: package reports '${deb_ver}' (want +${want}N)"; \
    case "${deb_ver}" in \
      *"+${want}"[0-9]*) ;; \
      *) echo "version gate: '${deb_ver}' does not carry +${want}N" >&2; exit 1 ;; \
    esac; \
    case "${deb_ver}" in \
      *"${other}"*) echo "version gate: '${deb_ver}' still names '${other}'" >&2; exit 1 ;; \
    esac; \
    if [ "${BUILD_VARIANT}" = "asan" ]; then \
        echo "version gate: binary route skipped for BUILD_VARIANT=asan"; exit 0; \
    fi; \
    root=/tmp/versiongate; rm -rf "$root"; install -d "$root"; \
    for f in /build/slapd_*.deb /build/libldap2_*.deb /build/libldap-common_*.deb; do \
        dpkg-deb -x "$f" "$root/pkg"; \
    done; \
    export LD_LIBRARY_PATH="$root/pkg/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    "$root/pkg/usr/sbin/slapd" -VV > "$root/out" 2>&1 || true; \
    cat "$root/out"; \
    # The assertion is EQUALITY against the version the metadata route already
    # judged, not a second token search. Do not be tempted to grep this output
    # for the other flavour's name: `slapd -VV` prints the Maintainer line too,
    # and that says "slaptain" on BOTH flavours by design (it is our packaging
    # either way). A check for the absence of "slaptain" here would fail every
    # legitimate pure build, and one for its presence would pass every pure
    # build no matter what the version said.
    #
    # Anchoring on the exact string also guards the reading: an empty or failed
    # -VV cannot satisfy it, where a bare "does not contain X" would.
    grep -q "OpenLDAP: slapd ${deb_ver} " "$root/out" || { \
        echo "version gate: slapd -VV does not report the package version \
'${deb_ver}' — the binary and the package disagree" >&2; exit 1; }; \
    rm -rf "$root"; \
    echo "version gate: OK (${want}, package and binary agree on ${deb_ver})"

# ── logpurge phase gate ─────────────────────────────────────────────────────
# accesslog-purge-phase.patch gives `logpurge` an optional third value, the
# phase (ADR-037). Everything downstream — the operator writing a per-pod phase,
# the rotation that depends on it — is silently useless against a slapd that
# dropped the patch, and a dropped patch has no other symptom: the two-value
# form keeps working, slapd keeps starting, and only the rotation stops being a
# rotation. So the build asserts the parser's arity here, on the binaries it
# just produced, the way `quilt push -a` asserts applicability.
#
# No second (stock) slapd is fetched for an A/B. The teeth come from the two
# rejections instead: a FOUR-value logpurge must still be refused, and a phase
# that is not less than the interval must be refused by the patch's own check.
#
# The gate is SYMMETRIC, because SLAPTAIN_PATCHES=0 is a real build and not an
# absence to be skipped over: a pure build must REFUSE the three-value form.
# Asserting that is what makes "pure" a verified property rather than a claim —
# and it is the same assertion in reverse, so one of the two always runs and
# neither can pass by not executing.
# A parser that accepted everything would fail both. That keeps the gate free of
# a network fetch and of any dependency on what a distro currently ships.
#
# What it proves is acceptance, not scheduling. slaptest runs in tool mode,
# where the patch deliberately does not record that a value carries a phase, so
# an offline read-back shows two values whatever was configured (see README.md).
# That the aligned grid is actually used is a property of a RUNNING slapd and is
# not observable from here.
#
# Skipped under asan: a sanitized binary can exit non-zero for reasons that have
# nothing to do with the parser, and it is not the artifact this gate protects —
# the same reasoning as the DPKG_GENSYMBOLS_CHECK_LEVEL relaxation above.
RUN set -eux; \
    if [ "${BUILD_VARIANT}" = "asan" ]; then \
        echo "logpurge phase gate: skipped for BUILD_VARIANT=asan"; exit 0; \
    fi; \
    root=/tmp/purgephase; \
    install -d "$root" "$root/db" "$root/alog"; \
    for f in /build/slapd_*.deb /build/libldap2_*.deb /build/libldap-common_*.deb; do \
        dpkg-deb -x "$f" "$root/pkg"; \
    done; \
    export LD_LIBRARY_PATH="$root/pkg/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH)"; \
    slaptest="$root/pkg/usr/sbin/slaptest"; \
    conf() { \
        printf 'include %s\nmodulepath %s\nmoduleload back_mdb\nmoduleload accesslog\n\ndatabase mdb\nsuffix "cn=accesslog"\ndirectory %s\n\ndatabase mdb\nsuffix "dc=example,dc=com"\ndirectory %s\noverlay accesslog\nlogdb cn=accesslog\nlogops writes\nlogpurge %s\n' \
            "$root/pkg/etc/ldap/schema/core.schema" "$root/pkg/usr/lib/ldap" \
            "$root/alog" "$root/db" "$1" > "$root/slapd.conf"; \
    }; \
    # 1. the three-value form the operator emits must be accepted.
    if [ "${SLAPTAIN_PATCHES}" != "1" ]; then \
        conf '0+00:15 0+00:05 0+00:02'; \
        if "$slaptest" -f "$root/slapd.conf" -u > "$root/out" 2>&1; then \
            echo "logpurge phase gate: a PURE build ACCEPTED a three-value logpurge — \
it is not pure" >&2; \
            cat "$root/out" >&2; exit 1; \
        fi; \
        grep -q 'extra cruft' "$root/out"; \
        conf '0+00:15 0+00:05'; \
        "$slaptest" -f "$root/slapd.conf" -u > "$root/out" 2>&1 || { \
            echo "logpurge phase gate: a pure build rejected the TWO-value form" >&2; \
            cat "$root/out" >&2; exit 1; \
        }; \
        grep -q 'config file testing succeeded' "$root/out"; \
        echo "logpurge phase gate: OK (pure — three values refused, two accepted)"; \
        exit 0; \
    fi; \
    conf '0+00:15 0+00:05 0+00:02'; \
    "$slaptest" -f "$root/slapd.conf" -u > "$root/out" 2>&1 || { \
        echo "logpurge phase gate: a three-value logpurge was REJECTED" >&2; \
        cat "$root/out" >&2; exit 1; }; \
    grep -q 'config file testing succeeded' "$root/out"; \
    cat "$root/out"; \
    # 2. a fourth value must still be cruft — the arity check is live.
    conf '0+00:15 0+00:05 0+00:02 0+00:01'; \
    if "$slaptest" -f "$root/slapd.conf" -u > "$root/out" 2>&1; then \
        echo "logpurge phase gate: a FOUR-value logpurge was accepted" >&2; \
        cat "$root/out" >&2; exit 1; \
    fi; \
    grep -q 'extra cruft' "$root/out"; \
    cat "$root/out"; \
    # 3. the patch's own bound: a phase outside the interval is not a phase.
    conf '0+00:15 0+00:05 0+00:05'; \
    if "$slaptest" -f "$root/slapd.conf" -u > "$root/out" 2>&1; then \
        echo "logpurge phase gate: phase >= interval was accepted" >&2; \
        cat "$root/out" >&2; exit 1; \
    fi; \
    grep -q 'phase must be less than interval' "$root/out"; \
    cat "$root/out"; \
    echo "logpurge phase gate: OK"

# Collect only the packages the images install. The -dev and slapd-contrib
# packages are build by-products we do not ship — the 2.6 images never carried
# contrib either, and 2.7's `slapd` module set is a superset of what Debian's
# 2.6 `slapd` shipped (minus back-perl/back-sql, retired upstream). The -dbgsym
# packages are dropped from a release build for the same reason and carried by a
# debug one: that is the whole difference between the two.
RUN set -eux; \
    install -d /debs; \
    for p in slapd ldap-utils libldap2 libldap-common; do \
        cp /build/${p}_*.deb /debs/; \
    done; \
    if [ "${BUILD_VARIANT}" != "release" ]; then \
        # dpkg has used both .deb and .ddeb for automatic debug packages; glob
        # for either rather than depend on which one this dpkg chose.
        for p in slapd libldap2; do \
            cp /build/${p}-dbgsym_*.*deb /debs/; \
        done; \
    fi; \
    # Fail here rather than in a container that will not start: an asan build
    # whose slapd is not linked against libasan is a silently useless image.
    # Reading it off Depends rather than the binary checks the consequence that
    # matters — dh_shlibdeps saw libasan.so.8, so the runtime image's apt will
    # pull libasan8 in when it installs this package.
    if [ "${BUILD_VARIANT}" = "asan" ]; then \
        dpkg-deb -f /debs/slapd_*.deb Depends | grep -q libasan; \
    fi; \
    ls -la /debs

# ── Artifact carrier ────────────────────────────────────────────────────────
FROM scratch
COPY --from=deb-build /debs /debs
