--- a/include/ldap_rq.h
+++ b/include/ldap_rq.h
@@ -33,6 +33,8 @@
 	char *tname;
 	char *tspec;
 	void *pool_cookie;
+	struct timeval phase;	/* offset from the epoch, when aligned */
+	int aligned;		/* fire at phase + k*interval, not now+interval */
 } re_t;
 
 typedef struct runqueue_s {
--- a/libraries/libldap/rq.c
+++ b/libraries/libldap/rq.c
@@ -182,7 +182,21 @@
 	LDAP_STAILQ_REMOVE( &rq->task_list, entry, re_s, tnext );
 
 	if ( !defer ) {
-		entry->next_sched.tv_sec = time( NULL ) + entry->interval.tv_sec;
+		if ( entry->aligned && entry->interval.tv_sec > 0 ) {
+			/* Fire on an absolute grid: phase + k*interval, counted
+			 * from the epoch, choosing the first slot strictly after
+			 * now. Derived from absolute time rather than from the
+			 * moment of dispatch, so scheduling latency cannot
+			 * accumulate and a restart returns to the same grid.
+			 */
+			time_t now = time( NULL );
+			time_t iv = entry->interval.tv_sec;
+			time_t ph = entry->phase.tv_sec % iv;
+
+			entry->next_sched.tv_sec = ph + ( ( now - ph ) / iv + 1 ) * iv;
+		} else {
+			entry->next_sched.tv_sec = time( NULL ) + entry->interval.tv_sec;
+		}
 	} else {
 		entry->next_sched.tv_sec = 0;
 	}
