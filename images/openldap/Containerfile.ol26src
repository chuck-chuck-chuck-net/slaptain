# OpenLDAP 2.6 .deb carrier built from DEBIAN'S OWN SOURCE PACKAGE, plus the
# local patches in images/openldap/local-patches/. Built and pushed by the
# *-ol26src targets, which address it at $(IMAGE_TAG)-ol26src and send it
# wherever REGISTRY points; publishing to the public registry stays CI's job,
# from main and from release tags.
#
# Why not Containerfile (the 2.7.1 path): that packaging is our fork, rebased
# onto pristine upstream 2.7.1, and several of its patches no longer apply to a
# 2.6 tree (getaddrinfo-is-threadsafe is the first to fail). Debian's trixie
# source package IS 2.6.10 and carries a patch series that applies to it, so
# starting there costs one `apt-get source` and leaves exactly one delta: ours.
#
# The result is the stock `-ol26` slapd plus the local patches and nothing else,
# which is what makes it usable as a measurement arm against that image.
FROM debian:trixie-slim AS deb-build

ENV DEBIAN_FRONTEND=noninteractive

# deb822 sources: add deb-src so `apt-get source` has something to fetch.
RUN set -eux; \
    sed -i 's/^Types: deb$/Types: deb deb-src/' /etc/apt/sources.list.d/debian.sources; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        build-essential ca-certificates devscripts equivs fakeroot quilt; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /build

# Debian's 2.6 source package, integrity-checked by apt against the archive.
ARG OPENLDAP_OL26_VERSION=2.6.10+dfsg-1
# Pinned for the same reason the binary pair is (ADR-040 decision 1): an
# unpinned `apt-get source` fetches whatever the archive serves today, so the
# patches below would be applied to a moving target.
RUN apt-get update && apt-get source slapd="${OPENLDAP_OL26_VERSION}" \
    && rm -rf /var/lib/apt/lists/*

COPY local-patches /build/local-patches

# Appended to Debian's series, so their patches apply first and ours last.
# Pushing the whole series and popping it again fails the build here rather
# than halfway through dpkg-buildpackage if a patch does not apply.
RUN set -eux; \
    cd openldap-*/; \
    for p in /build/local-patches/*.patch; do \
        cp "$p" debian/patches/; \
        basename "$p" >> debian/patches/series; \
    done; \
    QUILT_PATCHES=debian/patches quilt --quiltrc /dev/null push -a; \
    QUILT_PATCHES=debian/patches quilt --quiltrc /dev/null pop -a

# A distinct version, so a built package can never be mistaken for Debian's.
RUN set -eux; \
    cd openldap-*/; \
    dch --local '+slaptainphase' --distribution UNRELEASED \
        'Add the accesslog logpurge phase parameter (local patch).'

RUN set -eux; \
    cd openldap-*/; \
    apt-get update; \
    mk-build-deps -i -r -t 'apt-get -y --no-install-recommends' debian/control; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    cd openldap-*/; \
    export DEB_BUILD_OPTIONS="nocheck parallel=$(nproc)"; \
    dpkg-buildpackage -us -uc -b

# ── Carrier ─────────────────────────────────────────────────────────────────
# Same shape as the 2.7.1 carrier: a scratch image whose only content is /debs,
# consumed by images/slapd/Containerfile via --build-arg OPENLDAP_DEB_IMAGE.
FROM scratch
COPY --from=deb-build /build/*.deb /debs/
