FROM python:3.15-trixie@sha256:ce323fb792e0c3c6de88daab1a714542c6be2d4b14177aae410d0294c50b3d90

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
        ldap-utils \
        strace \
        procps \
        iputils-ping \
        iproute2 \
        tcpdump \
        lsof \
        dnsutils \
        netcat-openbsd \
        less \
        curl \
 && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir pyyaml ldap3
