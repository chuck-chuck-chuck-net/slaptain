# lab.yaml — lab inventory for the e2e suites. SAMPLE with placeholder values.
#
# Copy to <repo-root>/lab.yaml and fill in your lab's real values. lab.yaml is
# gitignored: it typically carries internal addresses and hostnames that must
# never be committed (see CLAUDE.md "References"). tests/e2e.sh picks it up
# automatically; E2E_CONFIG=<path> overrides the location.
#
# Unknown keys are ignored, so the file can carry more than slaptain reads.
# Environment variables always win over file values — the file supplies lab
# facts (sites, registry, network mode), never per-run knobs (GIT_TAG,
# SLAPD_TAG_SUFFIX, E2E_* gates, seeds).

# ── slaptain section ─────────────────────────────────────────────────────────
slaptain:
  # Container registry for all images. PROJECT (default "slaptain") is appended,
  # so images resolve to <registry>/slaptain/<image>:<tag> — set the org/prefix
  # here, not the project. Omit the key entirely for the public default,
  # ghcr.io/chuck-chuck-chuck-net.
  # NOTE: the REGISTRY environment variable overrides this, as it does every
  # value in this file. An exported REGISTRY in your shell silently wins.
  registry: registry.k8s.example
  operatorNamespace: slaptain-system
  testingNamespace: slaptain-testing
  testResources: example              # tests/resources/<dir> to apply
  replicationNetwork:
    mode: pod-routed                  # pod-routed (ADR-016) | multus (ADR-007)
    # multusNetwork: infra/replication-net   # required when mode: multus

# ── shared site inventory ────────────────────────────────────────────────────
# Order matters: the first site is the primary. When the e2e is invoked
# without context arguments, all sites are used (N≥2 → multi-site).
# THE SITE INVENTORY. `name` is the site IDENTITY: it becomes the operator's
# SITE_NAME, the mesh site name, the <site>-ca and <site>-kubeconfig Secret
# names, the /peers/<site>/ca.crt mount path, and what a database's seed.site is
# matched against. Choose it once; changing it later on a live mesh is a peer
# rename — a stanza rewrite and a volume remount, i.e. a cluster roll.
#
# `serverIDIndex` is the site's serverID decade (index × 100, ADR-017). Required
# and never inferred from list position: olcServerID is baked into every CSN the
# site's pods have written, so a site whose number moves splits its history
# across two sids. Reordering this list must be safe.
sites:
  - name: site-a
    serverIDIndex: 0                  # REQUIRED. decade 0 → pods 1,2,3
    context: site-a                   # kubectl context; OPTIONAL, defaults to name
    endpoint: https://192.0.2.10:6443 # site API URL routable FROM PODS on the
                                      # other sites (remote peer discovery).
                                      # On dual-homed nodes this is NOT the
                                      # address in your kubeconfig — that one
                                      # is the admin network. Read by
                                      # scripts/mesh-authorize-peers.sh and
                                      # scripts/mesh-derive-topology.sh.
    certIPs: []                       # OPTIONAL extra IP SANs for this site's
                                      # certificate, beyond nodeAccessIP. Pod IPs
                                      # do NOT belong here: IP-addressed peers use
                                      # tls_reqcert=allow (ADR-007). tests/e2e.sh
                                      # sets it to the node InternalIP for its own
                                      # derived copy of this file.
    nodeAccessIP: 198.51.100.10       # slaptain: NodePort + TLS-SAN address.
                                      # Needed on dual-homed nodes whose k8s
                                      # InternalIP the test runner cannot
                                      # reach; omit when InternalIP is fine.
    vms:                              # libvirt inventory for whole-site
                                      # outage scenarios (planned: ITS#9580
                                      # dormancy repro — idle/killed site)
      - {name: site-a-node1, uri: qemu+ssh://user@hypervisor.example/system}
      - {name: site-a-node2, uri: qemu+ssh://user@hypervisor.example/system}
  - name: site-b
    serverIDIndex: 1                  # decade 100 → pods 101,102,103
    context: site-b
    endpoint: https://192.0.2.20:6443
    nodeAccessIP: 198.51.100.20
    vms:
      - {name: site-b-node1, uri: qemu+ssh://user@hypervisor.example/system}
